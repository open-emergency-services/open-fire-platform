# Copy to .env and fill in. With NERIS creds blank, the API runs in simulation
# mode (no real submissions) so you can develop without credentials.

PORT=3000
DATABASE_URL=postgres://ofp:ofp@localhost:5432/ofp

# NERIS API (use the TEST/sandbox environment while developing)
NERIS_BASE_URL=https://api-test.neris.fsri.org/v1
# Obtain these by creating an API integration on your NERIS entity
# (create_api_integration -> generate_api_secret -> enroll_integration).
NERIS_CLIENT_ID=
NERIS_CLIENT_SECRET=

# Path to a local clone of https://github.com/ulfsri/neris-framework
# used by `npm run generate` in packages/neris-schema.
NERIS_FRAMEWORK_PATH=./neris-framework
