{
  "name": "open-fire-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, department-owned software for the fire service.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "npm --prefix packages/neris-schema run generate",
    "build:schema": "npm --prefix packages/neris-schema run build",
    "screens": "node apps/web/scripts/gen-screens.mjs",
    "typecheck": "npm --prefix apps/api run typecheck",
    "test": "npm --prefix apps/api run test",
    "dev": "npm --prefix apps/api run start:dev",
    "build": "npm run build:schema && npm --prefix apps/api run build"
  },
  "packageManager": "pnpm@9.0.0"
}
